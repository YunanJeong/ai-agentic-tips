{
  "theme": "dark",
  "model": "<INFERENCE_PROFILE_ARN_OR_MODEL_ID>",

  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "<REGION>",
    "AWS_BEARER_TOKEN_BEDROCK": "<BEDROCK_API_KEY>",
    "ANTHROPIC_MODEL": "<INFERENCE_PROFILE_ARN_OR_MODEL_ID>"
  },

  "permissions": {
    "deny": [
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(zsh -c:*)",

      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv)",
      "Bash(printenv:*)",

      "Bash(git config)",
      "Bash(git config:*)",
      "Bash(git remote)",
      "Bash(git remote:*)",
      "Bash(git credential:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git apply:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git submodule:*)",

      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(eksctl:*)",

      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state:*)",
      "Bash(terraform import:*)",
      "Bash(terraform output:*)",
      "Bash(terraform refresh:*)",
      "Bash(terraform workspace:*)",
      "Bash(terragrunt:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-vault:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/config)",
      "Read(**/.gitconfig)",
      "Read(**/.git-credentials)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.kube/**)",
      "Read(**/kubeconfig)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/credentials)"
    ]
  }
}
